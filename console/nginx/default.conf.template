# Console nginx: static SPA + same-origin reverse proxy to the orchestrator.
# ${ORCHESTRATOR_URL} is substituted by the nginx image's envsubst entrypoint.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # API — includes the SSE run stream: buffering must be OFF and the read
    # timeout generous or live events stall behind nginx.
    location /api/ {
        proxy_pass ${ORCHESTRATOR_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Pass the EDGE's X-Forwarded-Proto through (Kong terminates TLS in
        # front of us — our own $scheme is always http and would downgrade the
        # OAuth callback URL the orchestrator reconstructs). Empty when hit
        # directly with no edge, which the orchestrator treats as http.
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    # OAuth surface (login/callback/link/logout/providers) lives on the
    # orchestrator too — same reason the vite dev proxy forwards /auth.
    location /auth/ {
        proxy_pass ${ORCHESTRATOR_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    # Device uplink (register/heartbeat/poll/ack) — the local jcode connector
    # reaches the orchestrator through this same edge. Long-poll holds up to
    # 30s, so the read timeout must clear that comfortably.
    location /internal/ {
        proxy_pass ${ORCHESTRATOR_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
    }

    # Provider webhooks are public, signature-authenticated orchestrator
    # endpoints. They must not fall through to the static SPA handler: nginx
    # rejects POST requests to index.html with 405 before the orchestrator can
    # verify the provider signature or record the delivery receipt.
    location /webhooks/ {
        proxy_pass ${ORCHESTRATOR_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    # Public artifact viewer. The AES key lives only in the URL fragment, but
    # these page-scoped headers also prevent referrer leakage, framing, stale
    # decrypted navigation state, and unexpected network capabilities.
    location ^~ /s/ {
        add_header Referrer-Policy "no-referrer" always;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
        try_files $uri /index.html;
    }

    # SPA fallback.
    location / {
        try_files $uri /index.html;
    }
}
